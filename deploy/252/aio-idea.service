[Unit]
Description=AIO IDEA plugin application
After=network-online.target aio-plugin-supervisor.service
Wants=network-online.target aio-plugin-supervisor.service
RequiresMountsFor=/opt/aio-idea/worker-storage

[Service]
Type=simple
User=aio-shell
Group=aio-shell
WorkingDirectory=/opt/aio-idea/current
EnvironmentFile=-/opt/aio-idea/runtime.env
EnvironmentFile=-/opt/aio-idea/process.env
Environment=AIO_WEB_HOST=127.0.0.1
Environment=AIO_WEB_PORT=3080
Environment=AIO_WEB_DIST=/opt/aio-idea/current/web
Environment=AIO_CONFIG=/opt/aio-idea/current/aio.toml
Environment=AIO_PLUGIN_CACHE=/opt/aio-idea/plugin-cache
Environment=AIO_WORKER_STORAGE_DIR=/opt/aio-idea/worker-storage
Environment=AIO_PLUGIN_CACHE_MAX_BYTES=1073741824
Environment=AIO_PLUGIN_CACHE_MAX_ENTRIES=100000
Environment=AIO_PLUGIN_CACHE_MAX_REVISIONS=512
Environment=AIO_PLUGIN_SUPERVISOR_SOCKET=/run/aio-plugin-supervisor/supervisor.sock
Environment=AIO_SESSION_SECURE=1
Environment=AIO_PASSWORD_MIN_LENGTH=8
Environment=AIO_PLUGIN_PUBLISH_ACCOUNTS=zjarlin
Environment=AIO_LAUNCHER_ROOT=/opt/aio-idea
Environment=AIO_LAUNCHER_BINARY=aio-idea
Environment=AIO_LAUNCHER_HEALTH_URL=http://127.0.0.1:3080/health
Environment=AIO_LAUNCHER_RESTART=systemctl restart aio-idea.service
# 固定启动器位于 current 之外的稳定路径，切换发布不会替换正在运行的信任根。
ExecStart=/opt/aio-idea/launcher/aio-launcher boot
TimeoutStartSec=300
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
