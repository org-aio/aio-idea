# AIO IDEA 运行时：唯一默认值来源。复制到部署根目录（/root/DockerCompose/aio-idea/.env）
# 后填写，并 chmod 600。凭据不要提交，也不要写进 compose.yaml 或脚本。

# 部署主机的可读名称（用于文档与校验，不参与连接）
AIO_DEPLOY_HOST=<部署主机名>
# 站点公开入口；必须与端口门户登记的域名一致
AIO_PUBLIC_ORIGIN=https://<aio 域名>
# 设备隧道入口：必须与主站域名不同
AIO_DEVICE_TUNNEL_DOMAIN=<apps 域名>
AIO_DEVICE_TUNNEL_SCHEME=https

# 当前发布（40 位 Git SHA，由流水线原子切换；首次部署填 bootstrap）
AIO_RELEASE=bootstrap

# 独立 PostgreSQL
POSTGRES_DB=aio
POSTGRES_USER=aio
POSTGRES_PASSWORD=<随机口令>
POSTGRES_PORT=55432

# 只监听回环：内网可达性由 localmesh Caddy 的 bind + remote_ip 决定
AIO_WEB_PORT=3080
AIO_DEVICE_TUNNEL_PORT=8091

# 与旧部署一致的数字 UID/GID，恢复的文件归属不用改写
AIO_APP_UID=984
AIO_APP_GID=977
